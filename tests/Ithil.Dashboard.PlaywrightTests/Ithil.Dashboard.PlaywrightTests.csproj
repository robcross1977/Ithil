<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Playwright needs a real HTTP listener, so this is a Web SDK project -->
    <!--
      The SDK only includes Microsoft.AspNetCore.App.Internal.Assets (which provides
      _framework/blazor.server.js) when the host project contains .razor files.
      This test project hosts Blazor at runtime but owns no .razor files itself, so
      we set RequiresAspNetWebAssets explicitly to include the framework scripts.
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Single source of truth for the Playwright version: the PackageReference below
      and the InstallPlaywrightBrowsers target both read this property, so the driver
      and the downloaded browser builds cannot drift apart.
    -->
    <PlaywrightVersion>1.61.0</PlaywrightVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="Microsoft.Playwright" Version="$(PlaywrightVersion)" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ithil.Dashboard\Ithil.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\Ithil.Management\Ithil.Management.csproj" />
    <ProjectReference Include="..\..\src\Ithil.Core\Ithil.Core.csproj" />
  </ItemGroup>

  <!--
    Playwright is two halves that version in lockstep: the driver (this NuGet package)
    and the browser binaries (downloaded out-of-band into %LOCALAPPDATA%\ms-playwright
    on Windows, ~/.cache/ms-playwright elsewhere). Bumping the package without
    re-running the install leaves the driver asking for a browser build that isn't on
    disk, and every test fails in fixture setup with:

      Microsoft.Playwright.PlaywrightException : Executable doesn't exist at
      ...\ms-playwright\chromium_headless_shell-<build>\chrome-headless-shell.exe

    This target closes that gap by installing the matching browsers after a build.
    The stamp file is named for $(PlaywrightVersion), so a package bump invalidates it
    and triggers a fresh install while ordinary rebuilds skip it entirely.

    It shells out to the Node binary that ships inside the NuGet package rather than
    the generated playwright.ps1, which requires PowerShell Core (pwsh) on PATH and so
    silently fails on machines that only have Windows PowerShell.

    Escape hatches:
      -p:InstallPlaywrightBrowsers=false   skip entirely (CI image with browsers baked in)
      -p:PlaywrightBrowsers="chromium firefox"        install more than the default
    On a Linux CI runner the browsers also need OS packages; pass the Playwright
    with-deps flag via $(PlaywrightInstallArgs), or run the install as a separate
    root step before the test step.
  -->
  <PropertyGroup>
    <PlaywrightBrowsers Condition="'$(PlaywrightBrowsers)' == ''">chromium</PlaywrightBrowsers>
    <PlaywrightInstallArgs Condition="'$(PlaywrightInstallArgs)' == ''"></PlaywrightInstallArgs>
  </PropertyGroup>

  <Target Name="InstallPlaywrightBrowsers"
          AfterTargets="Build"
          Condition="'$(InstallPlaywrightBrowsers)' != 'false'">

    <PropertyGroup>
      <_PlaywrightStamp>$(IntermediateOutputPath)playwright-browsers.$(PlaywrightVersion).stamp</_PlaywrightStamp>
      <_PlaywrightCli>$(OutDir).playwright/package/cli.js</_PlaywrightCli>
    </PropertyGroup>

    <!-- The package lays down only the current RID's Node, so this matches one file. -->
    <ItemGroup>
      <_PlaywrightNode Include="$(OutDir).playwright/node/*/node.exe" />
      <_PlaywrightNode Include="$(OutDir).playwright/node/*/node" />
    </ItemGroup>

    <PropertyGroup>
      <_PlaywrightNodeExe>@(_PlaywrightNode->'%(FullPath)')</_PlaywrightNodeExe>
      <_ShouldInstallPlaywright>false</_ShouldInstallPlaywright>
      <_ShouldInstallPlaywright
        Condition="!Exists('$(_PlaywrightStamp)') And Exists('$(_PlaywrightNodeExe)') And Exists('$(_PlaywrightCli)')"
        >true</_ShouldInstallPlaywright>
    </PropertyGroup>

    <Message Importance="high"
             Condition="'$(_ShouldInstallPlaywright)' == 'true'"
             Text="Installing Playwright $(PlaywrightVersion) browsers ($(PlaywrightBrowsers)) — first build on this version, so this may take a few minutes." />

    <Exec Condition="'$(_ShouldInstallPlaywright)' == 'true'"
          Command="&quot;$(_PlaywrightNodeExe)&quot; &quot;$(_PlaywrightCli)&quot; install $(PlaywrightInstallArgs) $(PlaywrightBrowsers)" />

    <Touch Condition="'$(_ShouldInstallPlaywright)' == 'true'"
           Files="$(_PlaywrightStamp)"
           AlwaysCreate="true" />

    <!--
      Not fatal: a restore-only or design-time build may not have staged the driver yet,
      and failing the build there would be worse than a late, obvious test failure.
    -->
    <Warning Condition="!Exists('$(_PlaywrightStamp)') And '$(_ShouldInstallPlaywright)' != 'true'"
             Text="Could not auto-install Playwright browsers: the bundled Node driver was not found under $(OutDir).playwright. Tests will fail until you install browsers manually." />
  </Target>

</Project>
