<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      The SDK only includes Microsoft.AspNetCore.App.Internal.Assets (which provides
      _framework/blazor.server.js) when the host project contains .razor files.
      Ithil.Gateway owns no .razor files — they live in Ithil.Dashboard — so we set
      RequiresAspNetWebAssets explicitly to include the Blazor framework scripts in
      the static-asset manifest served by MapStaticAssets().
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LanguageExt.Core" Version="4.4.9" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
	<ProjectReference Include="..\Ithil.Dashboard\Ithil.Dashboard.csproj" /> 
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Ithil.Gateway.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ithil.Core\Ithil.Core.csproj" />
    <ProjectReference Include="..\Ithil.Cache\Ithil.Cache.csproj" />
    <ProjectReference Include="..\Ithil.Budget\Ithil.Budget.csproj" />
    <ProjectReference Include="..\Ithil.Privacy\Ithil.Privacy.csproj" />
    <ProjectReference Include="..\Ithil.Management\Ithil.Management.csproj" />
  </ItemGroup>

</Project>
