<MudTr Class="mud-warning-text">
    <MudTd>@Event.Timestamp</MudTd>
    <MudTd>
        <MudChip T="string" Color="Color.Warning" Size="Size.Small">Unidentified</MudChip>
    </MudTd>
    <MudTd>@Event.ToolName</MudTd>
    <MudTd>
        <MudChip T="string" Color="Color.Warning" Size="Size.Small">@Event.Status</MudChip>
    </MudTd>
    <MudTd>@Event.TokensUsed</MudTd>
    <MudTd>@(Event.LatencyMs.HasValue ? $"{Event.LatencyMs}ms" : "—")</MudTd>
    <MudTd>@(Event.CircuitState ?? "—")</MudTd>
</MudTr>
