<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 — AgentToolAttribute is a plain C# attribute with zero
         framework dependencies, so it works on any .NET version (8, 9, 10, …)
         and on .NET Framework 4.6.1+. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <PackageId>Ithil.Attributes</PackageId>
    <Version>0.1.0</Version>
    <Authors>Ithil Software</Authors>
    <Description>The [AgentTool] attribute for marking ASP.NET controller methods as MCP-callable tools. Works with the Ithil source generator to emit tool schemas at compile time.</Description>
    <PackageTags>mcp;ai;agent;gateway;ithil</PackageTags>
    <PackageProjectUrl>https://ithil.software</PackageProjectUrl>
    <RepositoryUrl>https://github.com/robcross1977/Ithil</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
