<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted so any .NET 8, 9, or 10 ASP.NET project can install this package.
         FrameworkReference to Microsoft.AspNetCore.App resolves per-TFM automatically. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <PackageId>Ithil.Hosting</PackageId>
    <Version>0.1.0</Version>
    <Authors>Ithil Software</Authors>
    <Description>Add Ithil governance to your ASP.NET API. Provides AddIthilHosting() and MapIthilSchema() for exposing source-generated tool schemas to the Ithil Gateway.</Description>
    <PackageTags>mcp;ai;agent;gateway;ithil</PackageTags>
    <PackageProjectUrl>https://ithil.software</PackageProjectUrl>
    <RepositoryUrl>https://github.com/robcross1977/Ithil</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
