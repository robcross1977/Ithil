<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Customers install a single package:
      dotnet add package Ithil.Hosting
    That package bundles the source generator and brings in Ithil.Attributes transitively.
    Project references are used here so the sample builds from source without a NuGet publish.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ithil.Hosting\Ithil.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Ithil.SourceGenerator\Ithil.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
